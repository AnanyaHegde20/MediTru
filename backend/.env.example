# MediTru Backend Environment Variables
# Copy this file to .env and fill in your values.

# Required: Google Gemini API key for AI features
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY="your_api_key_here"

# Optional: Comma-separated list of allowed frontend origins for CORS
# Defaults to http://localhost:3000 in development
ALLOWED_ORIGINS="http://localhost:3000"

# Optional: Server port (default: 3001)
PORT=3001

# Optional: JWT signing secret + token lifetime (default: 24h)
# Use a long random string (32+ characters) in production
JWT_SECRET="your_long_random_jwt_secret_here"
JWT_EXPIRATION_MS=86400000
